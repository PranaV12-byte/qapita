LLM_PROVIDER=mock
GROQ_API_KEY=
ANTHROPIC_API_KEY=
RETRIEVAL_FALLBACK_THRESHOLD=0.35
MOCK_DELAY=true
NEXT_PUBLIC_SITE_URL=https://your-app-base-url-here.com

# Authentication (Auth0)
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
AUTH0_SECRET=
APP_BASE_URL=https://your-app-base-url-here.com
NEXT_PUBLIC_AUTH0_SSO_CONNECTION=equityiq-demo-okta

# Email delivery. Production requires a Resend-verified sender domain.
EMAIL_DELIVERY_MODE=production
RESEND_API_KEY=
EMAIL_FROM=EquityIQ <answers@your-verified-domain.example>
RESEND_TEST_RECIPIENT=
EMAIL_REPLY_TO=

# ── Retrieval / RAG ─────────────────────────────────────────────────────────
# Deploy-safe defaults use the deterministic 384-dimensional hash embedder.
EMBEDDER_MODE=hash
# To upgrade to the higher-quality bge-base once its ONNX weights are on disk:
#   EMBEDDER_MODEL=Xenova/bge-base-en-v1.5
#   EMBEDDING_DIM=768
#   EMBED_QUERY_PREFIX=Represent this sentence for searching relevant passages:
# Enable the local cross-encoder reranker once its weights are present:
#   RERANK_ENABLED=true
# Only on a networked machine, to fetch model weights once from the HF hub:
#   ALLOW_REMOTE_MODELS=true
# Optional LLM contextual enrichment at ingest (offline batch; needs GROQ_API_KEY):
#   CONTEXTUAL_ENRICHMENT=true
# Point the classifier at your unsorted markdown before running `npm run classify`:
#   SCRAPE_INBOX=./scrape-inbox

# ── Second Brain (per-user wiki — SPEC-BRAIN.md) ────────────────────────────
# All optional; defaults shown. LLM maintenance (placement/summaries/lint) uses
# LLM_PROVIDER=groq + GROQ_API_KEY when set, else deterministic heuristics.
#   USER_WEIGHT=1.0              # retrieval weight of the user's own chunks
#   GRAPH_EXPANSION=true         # pull graph neighbours into an answer's context
#   NEIGHBOR_LIMIT=4             # max neighbour passages added
#   NEIGHBOR_MIN_COSINE=0.25     # gate for neighbour relevance
#   BRAIN_MAX_FILE_MB=4          # per-uploaded-file size cap
#   BRAIN_MAX_TEXT_MB=1.5        # per-file extracted-text cap
#   BRAIN_MAX_PASSAGES=5000      # soft per-brain passage cap
#   BRAIN_BATCH_LIMIT=10         # files per upload
#   LINT_APPEND_THRESHOLD=5      # appends before a cadence lint fires
#   LINT_STALE_DAYS=7            # days-stale before a cadence lint fires
#   BRAIN_LRU=50                 # in-memory loaded-brain cache size
# Prune stale anonymous brains:  npm run brains:prune -- --days 30 --apply
